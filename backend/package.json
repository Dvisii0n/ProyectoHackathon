{
  "name": "hackathon-api",
  "version": "1.0.0",
  "description": "Plantilla básica de API REST con Express, PostgreSQL y autenticación JWT",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/db/init.js",
    "db:admin": "node src/db/seed-admin.js"
  },
  "engines": {
